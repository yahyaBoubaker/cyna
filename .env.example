# Copier ce fichier en ".env" (à la racine, à côté de docker-compose.yml) pour envoyer
# les e-mails vers de vraies adresses. Sans .env, les e-mails restent capturés par Mailpit.
# Le fichier .env est git-ignoré : ne JAMAIS commiter de mot de passe.
# (Ne mettez PAS vos vrais identifiants dans ce fichier .env.example : lui est commité.)

# --- Gmail ---
# 1. Activer la validation en 2 étapes sur le compte Google : https://myaccount.google.com/security
# 2. Générer un "mot de passe d'application" : https://myaccount.google.com/apppasswords
# 3. Coller ici les 16 caractères (sans espaces, sans guillemets) :
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-adresse@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_ENCRYPTION=starttls
SMTP_FROM=votre-adresse@gmail.com

# Après modification : docker compose up -d --force-recreate backend
